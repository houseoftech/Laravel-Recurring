{
    "name": "houseoftech/laravel-recurring",
    "description": "simshaun/recurr integration for Laravel/Eloquent.",
    "keywords": [
        "laravel",
        "framework",
        "Laravel-Recurring",
        "Laravel Recurring"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Brian Faust",
            "email": "hello@brianfaust.de",
            "homepage": "https://brianfaust.de"
        },
        {
            "name": "Corie Slate"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "simshaun/recurr": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "BrianFaust\\Recurring\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BrianFaust\\Tests\\Recurring\\": "tests"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "4.x-dev"
        },
        "laravel": {
            "providers": [
                "BrianFaust\\Recurring\\LaravelRecurringServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
